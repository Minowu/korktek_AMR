      replacement_content: "import React from \'react\';\nimport { AlertTriangle, CheckCircle2 } from \'lucide-react\';\n\ninterface ConfirmModalProps {\n  isOpen: boolean;\n  title: string;\n  message: string;\n  confirmText?: string;\n  cancelText?: string;\n  variant?: \'primary\' | \'warning\' | \'danger\';\n  isLoading?: boolean;\n  onConfirm: () => void;\n  onCancel: () => void;\n}\n\nexport const ConfirmModal: React.FC<ConfirmModalProps> = ({\n  isOpen,\n  title,\n  message,\n  confirmText = \'X\303\201C NH\341\272\254N\',\n  cancelText = \'H\341\273\246Y\',\n  variant = \'primary\',\n  isLoading = false,\n  onConfirm,\n  onCancel,\n}) => {\n  if (!isOpen) return null;\n\n  const getButtonBg = () => {\n    switch (variant) {\n      case \'warning\':\n        return \'bg-amber-600 hover:bg-amber-700 active:bg-amber-800 text-white\';\n      case \'danger\':\n        return \'bg-red-600 hover:bg-red-700 active:bg-red-800 text-white\';\n      default:\n        return \'bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white\';\n    }\n  };\n\n  return (\n    <div\n      id=\"confirm-modal-overlay\"\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n    >\n      <div\n        id=\"confirm-modal-content\"\n        className=\"w-full max-w-sm bg-slate-900 border-2 border-slate-700 rounded-2xl shadow-2xl p-5 text-slate-100\"\n      >\n        <div className=\"flex items-center gap-3 mb-3\">\n          {variant === \'warning\' || variant === \'danger\' ? (\n            <div className=\"w-10 h-10 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0\">\n              <AlertTriangle className=\"w-6 h-6\" />\n            </div>\n          ) : (\n            <div className=\"w-10 h-10 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center shrink-0\">\n              <CheckCircle2 className=\"w-6 h-6\" />\n            </div>\n          )}\n          <h2 className=\"text-xl font-bold tracking-tight text-white\">{title}</h2>\n        </div>\n\n        <p className=\"text-slate-300 text-base leading-relaxed mb-6 font-normal\">\n          {message}\n        </p>\n\n        <div className=\"grid grid-cols-2 gap-3\">\n          <button\n            id=\"modal-cancel-btn\"\n            type=\"button\"\n            disabled={isLoading}\n            onClick={onCancel}\n            className=\"w-full min-h-[52px] px-4 py-3 rounded-xl font-semibold text-base bg-slate-800 hover:bg-slate-700 active:bg-slate-600 text-slate-200 border border-slate-600 transition-colors\"\n          >\n            {cancelText}\n          </button>\n          <button\n            id=\"modal-confirm-btn\"\n            type=\"button\"\n            disabled={isLoading}\n            onClick={onConfirm}\n            className={`w-full min-h-[52px] px-4 py-3 rounded-xl font-bold text-base shadow-lg transition-colors flex items-center justify-center ${getButtonBg()}`}\n          >\n            {isLoading ? (\n              <span className=\"inline-block w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n            ) : (\n              confirmText\n            )}\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
