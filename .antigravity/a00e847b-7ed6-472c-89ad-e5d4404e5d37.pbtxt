  file_change {
    absolute_path_uri: "file:///server/state.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "export interface LineState {\n  status: \'idle\' | \'running\';\n  currentOrderId: string | null;\n  lockedAt: string | null;\n  lockedByStation: string | null;\n}\n\nexport interface ActivityLog {\n  id: string;\n  timestamp: string;\n  type: \'ORDER\' | \'TRIGGER\' | \'RESET\' | \'ERROR\';\n  line: string;\n  station?: string;\n  orderId?: string;\n  payload?: any;\n  response?: any;\n  success: boolean;\n  message: string;\n  durationMs?: number;\n}\n\nclass SystemStateManager {\n  private lineStates: Record<string, LineState> = {\n    \'line-a\': {\n      status: \'idle\',\n      currentOrderId: null,\n      lockedAt: null,\n      lockedByStation: null,\n    },\n    \'line-b\': {\n      status: \'idle\',\n      currentOrderId: null,\n      lockedAt: null,\n      lockedByStation: null,\n    },\n  };\n\n  private lastTimestampMs = 0;\n  private logs: ActivityLog[] = [];\n  private maxLogs = 50;\n\n  /**\n   * Generates a unique orderId with format: cong_YYYYMMDD_HHMMSS_mmm\n   * Implements Mutex / sequential guarantee:\n   * If request arrives at the same millisecond or earlier, advances by 1ms.\n   */\n  public generateUniqueOrderId(): string {\n    let now = Date.now();\n    if (now <= this.lastTimestampMs) {\n      now = this.lastTimestampMs + 1;\n    }\n    this.lastTimestampMs = now;\n\n    const d = new Date(now);\n    const yyyy = d.getFullYear().toString();\n    const mm = (d.getMonth() + 1).toString().padStart(2, \'0\');\n    const dd = d.getDate().toString().padStart(2, \'0\');\n    const hh = d.getHours().toString().padStart(2, \'0\');\n    const mi = d.getMinutes().toString().padStart(2, \'0\');\n    const ss = d.getSeconds().toString().padStart(2, \'0\');\n    const mmm = d.getMilliseconds().toString().padStart(3, \'0\');\n\n    return `cong_${yyyy}${mm}${dd}_${hh}${mi}${ss}_${mmm}`;\n  }\n\n  public getLineState(lineKey: string): LineState {\n    const state = this.lineStates[lineKey];\n    if (!state) {\n      return { status: \'idle\', currentOrderId: null, lockedAt: null, lockedByStation: null };\n    }\n    return { ...state };\n  }\n\n  public getAllStates(): Record<string, LineState> {\n    return { ...this.lineStates };\n  }\n\n  /**\n   * Atomic lock attempt. Returns error message if already locked.\n   */\n  public tryLockLine(lineKey: string, stationKey: string, orderId: string): { success: boolean; error?: string } {\n    const current = this.lineStates[lineKey];\n    if (!current) {\n      return { success: false, error: `Line \'${lineKey}\' kh\303\264ng t\341\273\223n t\341\272\241i trong c\341\272\245u h\303\254nh h\341\273\207 th\341\273\221ng.` };\n    }\n\n    if (current.status === \'running\') {\n      return {\n        success: false,\n        error: `Line \'${lineKey.toUpperCase()}\' \304\221ang ch\341\272\241y l\341\273\207nh (${current.currentOrderId}). N\303\272t G\341\273\214I L\341\273\206NH \304\221ang b\341\273\213 kh\303\263a.`,\n      };\n    }\n\n    // Lock line\n    this.lineStates[lineKey] = {\n      status: \'running\',\n      currentOrderId: orderId,\n      lockedAt: new Date().toISOString(),\n      lockedByStation: stationKey,\n    };\n\n    return { success: true };\n  }\n\n  /**\n   * Reset line to idle (Decision 1 - Option A)\n   */\n  public resetLine(lineKey: string): { success: boolean; message: string } {\n    if (!this.lineStates[lineKey]) {\n      return { success: false, message: `Line \'${lineKey}\' kh\303\264ng t\341\273\223n t\341\272\241i.` };\n    }\n\n    const previousOrderId = this.lineStates[lineKey].currentOrderId;\n    this.lineStates[lineKey] = {\n      status: \'idle\',\n      currentOrderId: null,\n      lockedAt: null,\n      lockedByStation: null,\n    };\n\n    this.addLog({\n      type: \'RESET\',\n      line: lineKey,\n      success: true,\n      message: `\304\220\303\243 m\341\273\237 kh\303\263a (reset) ${lineKey.toUpperCase()} v\341\273\201 tr\341\272\241ng th\303\241i IDLE (L\341\273\207nh tr\306\260\341\273\233c: ${previousOrderId || \'None\'}).`,\n    });\n\n    return { success: true, message: `\304\220\303\243 m\341\273\237 kh\303\263a Line ${lineKey.toUpperCase()} th\303\240nh c\303\264ng.` };\n  }\n\n  public addLog(log: Omit<ActivityLog, \'id\' | \'timestamp\'>) {\n    const entry: ActivityLog = {\n      ...log,\n      id: Math.random().toString(36).substring(2, 9),\n      timestamp: new Date().toISOString(),\n    };\n    this.logs.unshift(entry);\n    if (this.logs.length > this.maxLogs) {\n      this.logs.pop();\n    }\n  }\n\n  public getLogs(): ActivityLog[] {\n    return [...this.logs];\n  }\n}\n\nexport const stateManager = new SystemStateManager();\n"
    }
