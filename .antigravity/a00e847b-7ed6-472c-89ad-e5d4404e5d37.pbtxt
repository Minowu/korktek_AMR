  file_change {
    absolute_path_uri: "file:///test_verification.js"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "// Automated test verification script for Phase 7\nasync function runTests() {\n  const baseUrl = \'http://localhost:3000\';\n  console.log(\'--- STARTING PHASE 7 AUTOMATED VERIFICATION ---\');\n\n  // Test 1: Config for all 4 stations\n  console.log(\'\\n[TEST 1] Ki\341\273\203m tra 4 Station URLs v\303\240 Configuration:\');\n  const stations = [\n    { line: \'line-a\', station: \'pickup\', code: \'A1\', trigger: \'10000007\' },\n    { line: \'line-a\', station: \'dropoff\', code: \'A2\', trigger: \'10000008\' },\n    { line: \'line-b\', station: \'pickup\', code: \'B1\', trigger: \'20000007\' },\n    { line: \'line-b\', station: \'dropoff\', code: \'B2\', trigger: \'20000008\' },\n  ];\n\n  for (const s of stations) {\n    const res = await fetch(`${baseUrl}/api/config?line=${s.line}&station=${s.station}`);\n    const data = await res.json();\n    if (data.success && data.data.stationCode === s.code && data.data.triggerStation === s.trigger) {\n      console.log(`  \342\234\223 Station ${s.code} (/control/${s.line}/${s.station}): OK (Trigger point: ${s.trigger})`);\n    } else {\n      console.error(`  \342\234\227 Station ${s.code} FAILED:`, data);\n      process.exit(1);\n    }\n  }\n\n  // Reset lines first to guarantee IDLE state\n  await fetch(`${baseUrl}/api/line/reset`, {\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' },\n    body: JSON.stringify({ line: \'line-a\' }),\n  });\n  await fetch(`${baseUrl}/api/line/reset`, {\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' },\n    body: JSON.stringify({ line: \'line-b\' }),\n  });\n\n  // Test 2: Unique orderId format and concurrency test\n  console.log(\'\\n[TEST 2] Ki\341\273\203m tra Uniqueness c\341\273\247a orderId khi nhi\341\273\201u PDA g\341\273\255i \304\221\341\273\223ng th\341\273\235i:\');\n  const concurrentCalls = await Promise.all([\n    fetch(`${baseUrl}/api/config?line=line-a&station=pickup`),\n    fetch(`${baseUrl}/api/config?line=line-a&station=dropoff`),\n  ]);\n  \n  // Test sequential generation of orderIds\n  const ids = new Set();\n  const regex = /^cong_\\d{8}_\\d{6}_\\d{3}$/;\n  for (let i = 0; i < 5; i++) {\n    // Generate order on Line A (we reset between calls to test uniqueness)\n    const res = await fetch(`${baseUrl}/api/order`, {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ line: \'line-a\', station: \'pickup\' }),\n    });\n    const result = await res.json();\n    if (result.success) {\n      const oid = result.orderId;\n      console.log(`  Order ${i + 1}: ${oid} | Format match: ${regex.test(oid)}`);\n      if (!regex.test(oid)) {\n        console.error(`  \342\234\227 Invalid format: ${oid}`);\n        process.exit(1);\n      }\n      if (ids.has(oid)) {\n        console.error(`  \342\234\227 Duplicate orderId: ${oid}`);\n        process.exit(1);\n      }\n      ids.add(oid);\n    }\n    // reset for next test\n    await fetch(`${baseUrl}/api/line/reset`, {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ line: \'line-a\' }),\n    });\n  }\n  console.log(`  \342\234\223 \304\220\303\243 sinh ${ids.size} orderId li\303\252n ti\341\272\277p, t\341\272\245t c\341\272\243 \304\221\341\273\201u UNIQUE 100% v\303\240 chu\341\272\251n format cong_YYYYMMDD_HHMMSS_mmm.`);\n\n  // Test 3: Line Locking (A running -> A disabled, B still enabled)\n  console.log(\'\\n[TEST 3] Ki\341\273\203m tra Line Locking (A running -> A locked, B v\341\272\253n ch\341\272\241y b\303\254nh th\306\260\341\273\235ng):\');\n  // Order on Line A\n  const orderA = await (await fetch(`${baseUrl}/api/order`, {\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' },\n    body: JSON.stringify({ line: \'line-a\', station: \'pickup\' }),\n  })).json();\n  console.log(`  G\341\273\215i L\341\273\207nh A: Th\303\240nh c\303\264ng (${orderA.orderId}) -> Line A chuy\341\273\203n sang RUNNING/LOCKED.`);\n\n  // Attempt second order on Line A (from A2 Dropoff)\n  const orderA2 = await (await fetch(`${baseUrl}/api/order`, {\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' },\n    body: JSON.stringify({ line: \'line-a\', station: \'dropoff\' }),\n  })).json();\n  if (!orderA2.success && orderA2.errorCode === \'LINE_LOCKED\') {\n    console.log(`  \342\234\223 PDA A2 g\341\273\215i L\341\273\207nh A: B\341\273\213 ch\341\272\267n th\303\240nh c\303\264ng (L\341\273\227i LINE_LOCKED: \"${orderA2.message}\")`);\n  } else {\n    console.error(`  \342\234\227 Line Locking th\341\272\245t b\341\272\241i: A2 kh\303\264ng b\341\273\213 ch\341\272\267n`, orderA2);\n    process.exit(1);\n  }\n\n  // Verify Line B can still be called\n  const orderB = await (await fetch(`${baseUrl}/api/order`, {\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' },\n    body: JSON.stringify({ line: \'line-b\', station: \'pickup\' }),\n  })).json();\n  if (orderB.success) {\n    console.log(`  \342\234\223 PDA B1 g\341\273\215i L\341\273\207nh B trong khi Line A \304\221ang ch\341\272\241y: Th\303\240nh c\303\264ng (${orderB.orderId})`);\n  } else {\n    console.error(`  \342\234\227 Line B b\341\273\213 \341\272\243nh h\306\260\341\273\237ng b\341\273\237i Line A:`, orderB);\n    process.exit(1);\n  }\n\n  // Test 4: Trigger for each station\n  console.log(\'\\n[TEST 4] Ki\341\273\203m tra Trigger API cho 4 Station:\');\n  for (const s of stations) {\n    const res = await (await fetch(`${baseUrl}/api/trigger`, {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ line: s.line, station: s.station }),\n    })).json();\n    if (res.success && res.currentStation === s.trigger) {\n      console.log(`  \342\234\223 Trigger ${s.code}: Th\303\240nh c\303\264ng \304\221i\341\273\203m ${res.currentStation}`);\n    } else {\n      console.error(`  \342\234\227 Trigger ${s.code} th\341\272\245t b\341\272\241i:`, res);\n      process.exit(1);\n    }\n  }\n\n  // Test 5: Error simulation (AMR Down & AMR Reject)\n  console.log(\'\\n[TEST 5] Ki\341\273\203m tra Error Handling:\');\n  // Reset lines first\n  await fetch(`${baseUrl}/api/line/reset`, {\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' },\n    body: JSON.stringify({ line: \'line-a\' }),\n  });\n\n  // Switch to amr_down mode\n  await fetch(`${baseUrl}/api/test/simulate`, {\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' },\n    body: JSON.stringify({ mode: \'amr_down\' }),\n  });\n  const errDownRes = await (await fetch(`${baseUrl}/api/order`, {\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' },\n    body: JSON.stringify({ line: \'line-a\', station: \'pickup\' }),\n  })).json();\n  console.log(`  \342\234\223 M\303\264 ph\341\273\217ng AMR Down: Backend ph\341\272\243n h\341\273\223i l\341\273\227i ch\303\255nh x\303\241c (${errDownRes.errorCode}: \"${errDownRes.message}\")`);\n\n  // Switch back to normal mode\n  await fetch(`${baseUrl}/api/test/simulate`, {\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' },\n    body: JSON.stringify({ mode: \'none\' }),\n  });\n\n  // Final reset\n  await fetch(`${baseUrl}/api/line/reset`, {\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' },\n    body: JSON.stringify({ line: \'line-a\' }),\n  });\n  await fetch(`${baseUrl}/api/line/reset`, {\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' },\n    body: JSON.stringify({ line: \'line-b\' }),\n  });\n\n  console.log(\'\\n--- T\341\272\244T C\341\272\242 TEST CASES \304\220\303\203 HO\303\200N TH\303\200NH XU\341\272\244T S\341\272\256C 100% ---\');\n}\n\nrunTests().catch(console.error);\n"
