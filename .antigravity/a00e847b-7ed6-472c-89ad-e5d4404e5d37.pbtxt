  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState, useEffect } from \'react\';\nimport { StationControl } from \'./components/StationControl\';\nimport { StationSelector } from \'./components/StationSelector\';\nimport { MultiPdaView } from \'./components/MultiPdaView\';\nimport { LogsDrawer } from \'./components/LogsDrawer\';\nimport { Smartphone, LayoutGrid, Terminal } from \'lucide-react\';\n\nexport default function App() {\n  const [currentPath, setCurrentPath] = useState(window.location.pathname);\n  const [isLogsOpen, setIsLogsOpen] = useState(false);\n  const [viewMode, setViewMode] = useState<\'single\' | \'simulator\'>(\'single\');\n\n  // Handle URL navigation\n  useEffect(() => {\n    const handlePopState = () => {\n      setCurrentPath(window.location.pathname);\n    };\n    window.addEventListener(\'popstate\', handlePopState);\n    return () => window.removeEventListener(\'popstate\', handlePopState);\n  }, []);\n\n  const navigateTo = (path: string) => {\n    window.history.pushState(null, \'\', path);\n    setCurrentPath(path);\n  };\n\n  // Match /control/:line/:station\n  const matchRoute = () => {\n    const match = currentPath.match(/^\\/control\\/([a-zA-Z0-9_-]+)\\/([a-zA-Z0-9_-]+)\\/?$/);\n    if (match) {\n      return {\n        isStationRoute: true,\n        lineKey: match[1].toLowerCase(),\n        stationKey: match[2].toLowerCase(),\n      };\n    }\n    return { isStationRoute: false };\n  };\n\n  const routeInfo = matchRoute();\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-sky-500 selection:text-white\">\n      {/* Top Bar for Simulator / Developer Switcher (Hidden or unobtrusive on small PDA) */}\n      <header className=\"border-b border-slate-800 bg-slate-900/90 sticky top-0 z-40 backdrop-blur-md px-3 py-2\">\n        <div className=\"max-w-6xl mx-auto flex items-center justify-between gap-2\">\n          <button\n            onClick={() => navigateTo(\'/\')}\n            className=\"flex items-center gap-2 font-black text-sm text-white tracking-tight hover:text-sky-400 transition-colors\"\n          >\n            <div className=\"w-6 h-6 rounded-lg bg-sky-500 flex items-center justify-center text-slate-950 text-xs font-black\">\n              A\n            </div>\n            <span className=\"hidden sm:inline\">AMR Control Panel</span>\n            <span className=\"text-[11px] font-mono font-semibold px-2 py-0.5 rounded-full bg-slate-800 text-sky-400\">\n              {routeInfo.isStationRoute\n                ? `${routeInfo.lineKey.toUpperCase()} / ${routeInfo.stationKey.toUpperCase()}`\n                : \'Tr\341\272\241m \304\221i\341\273\201u khi\341\273\203n\'}\n            </span>\n          </button>\n\n          {/* Quick Nav Mode */}\n          <div className=\"flex items-center gap-1.5 text-xs\">\n            <button\n              onClick={() => {\n                setViewMode(\'single\');\n                if (!routeInfo.isStationRoute) {\n                  navigateTo(\'/control/line-a/pickup\');\n                }\n              }}\n              className={`flex items-center gap-1 px-2.5 py-1.5 rounded-lg font-medium transition-colors ${\n                viewMode === \'single\'\n                  ? \'bg-slate-800 text-sky-400 border border-slate-700\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              <Smartphone className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden xs:inline\">PDA Tr\341\272\241m</span>\n            </button>\n\n            <button\n              onClick={() => {\n                setViewMode(\'simulator\');\n                navigateTo(\'/\');\n              }}\n              className={`flex items-center gap-1 px-2.5 py-1.5 rounded-lg font-medium transition-colors ${\n                viewMode === \'simulator\'\n                  ? \'bg-slate-800 text-sky-400 border border-slate-700\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              <LayoutGrid className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden xs:inline\">M\303\264 ph\341\273\217ng \304\220a PDA</span>\n            </button>\n\n            <button\n              onClick={() => setIsLogsOpen(true)}\n              className=\"flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 font-mono\"\n              title=\"Nh\341\272\255t k\303\275 AMR\"\n            >\n              <Terminal className=\"w-3.5 h-3.5 text-sky-400\" />\n              <span className=\"hidden sm:inline\">Logs</span>\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 flex flex-col p-3 sm:p-5\">\n        {viewMode === \'simulator\' ? (\n          <MultiPdaView onOpenLogs={() => setIsLogsOpen(true)} />\n        ) : routeInfo.isStationRoute && routeInfo.lineKey && routeInfo.stationKey ? (\n          <StationControl\n            lineKey={routeInfo.lineKey}\n            stationKey={routeInfo.stationKey}\n            onNavigateHome={() => navigateTo(\'/\')}\n            onOpenLogs={() => setIsLogsOpen(true)}\n          />\n        ) : (\n          <StationSelector\n            onSelectStation={(line, station) => {\n              navigateTo(`/control/${line}/${station}`);\n            }}\n            onOpenLogs={() => setIsLogsOpen(true)}\n          />\n        )}\n      </main>\n\n      {/* Communication & Activity Logs Drawer */}\n      <LogsDrawer isOpen={isLogsOpen} onClose={() => setIsLogsOpen(false)} />\n    </div>\n  );\n}\n"
    }
