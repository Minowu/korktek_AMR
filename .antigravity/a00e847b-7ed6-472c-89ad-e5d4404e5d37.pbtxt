  file_change {
    absolute_path_uri: "file:///server/amrClient.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import fs from \'fs\';\nimport path from \'path\';\n\nexport interface AmrConfig {\n  amrSystem: {\n    baseUrl: string;\n    orderPath: string;\n    triggerPath: string;\n    timeoutMs: number;\n    mockMode: boolean;\n  };\n  orderCommon: {\n    modelProcessCode: string;\n    priority: number;\n    fromSystem: string;\n  };\n  lines: Record<\n    string,\n    {\n      name: string;\n      orderLabel: string;\n      taskPath: string;\n      stations: Record<\n        string,\n        {\n          code: string;\n          name: string;\n          triggerStation: string;\n        }\n      >;\n    }\n  >;\n}\n\nexport interface AmrOrderPayload {\n  modelProcessCode: string;\n  priority: number;\n  fromSystem: string;\n  orderId: string;\n  taskOrderDetail: Array<{\n    taskPath: string;\n  }>;\n}\n\nexport interface AmrTriggerPayload {\n  currentStation: string;\n}\n\nclass AmrClientService {\n  private configPath = path.join(process.cwd(), \'server\', \'config.json\');\n  private config!: AmrConfig;\n  private simulateFailure: \'none\' | \'amr_down\' | \'amr_reject\' = \'none\';\n\n  constructor() {\n    this.loadConfig();\n  }\n\n  public loadConfig(): AmrConfig {\n    try {\n      const data = fs.readFileSync(this.configPath, \'utf8\');\n      this.config = JSON.parse(data);\n      return this.config;\n    } catch (err) {\n      console.error(\'L\341\273\227i khi \304\221\341\273\215c file c\341\272\245u h\303\254nh config.json:\', err);\n      throw new Error(\'Kh\303\264ng th\341\273\203 \304\221\341\273\215c file c\341\272\245u h\303\254nh server/config.json\');\n    }\n  }\n\n  public getConfig(): AmrConfig {\n    if (!this.config) {\n      this.loadConfig();\n    }\n    return this.config;\n  }\n\n  public setSimulateFailure(mode: \'none\' | \'amr_down\' | \'amr_reject\') {\n    this.simulateFailure = mode;\n  }\n\n  public getSimulateFailure() {\n    return this.simulateFailure;\n  }\n\n  public toggleMockMode(enabled: boolean) {\n    this.config.amrSystem.mockMode = enabled;\n  }\n\n  /**\n   * Send Order to AMR System\n   */\n  public async sendOrder(payload: AmrOrderPayload): Promise<{\n    success: boolean;\n    data?: any;\n    error?: string;\n    httpStatus?: number;\n    durationMs: number;\n  }> {\n    const startTime = Date.now();\n    const { baseUrl, orderPath, timeoutMs, mockMode } = this.config.amrSystem;\n\n    if (mockMode) {\n      await new Promise((resolve) => setTimeout(resolve, 350));\n      const durationMs = Date.now() - startTime;\n\n      if (this.simulateFailure === \'amr_down\') {\n        return {\n          success: false,\n          error: \'AMR System kh\303\264ng ph\341\272\243n h\341\273\223i (M\303\264 ph\341\273\217ng m\341\272\241ng b\341\273\213 ng\341\272\257t k\341\272\277t n\341\273\221i / Connection Refused)\',\n          durationMs,\n        };\n      }\n\n      if (this.simulateFailure === \'amr_reject\') {\n        return {\n          success: false,\n          error: \'AMR System t\341\273\253 ch\341\273\221i l\341\273\207nh: Robot \304\221ang \341\273\237 tr\341\272\241ng th\303\241i b\303\241o l\341\273\227i / E-stop\',\n          httpStatus: 400,\n          durationMs,\n        };\n      }\n\n      return {\n        success: true,\n        data: {\n          code: 0,\n          msg: \'Order created successfully\',\n          data: { orderId: payload.orderId },\n        },\n        durationMs,\n      };\n    }\n\n    // Real HTTP call to AMR System\n    const controller = new AbortController();\n    const timeoutId = setTimeout(() => controller.abort(), timeoutMs || 5000);\n    const targetUrl = `${baseUrl.replace(/\\/+$/, \'\')}${orderPath}`;\n\n    try {\n      const response = await fetch(targetUrl, {\n        method: \'POST\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n        },\n        body: JSON.stringify(payload),\n        signal: controller.signal,\n      });\n\n      clearTimeout(timeoutId);\n      const durationMs = Date.now() - startTime;\n      const text = await response.text();\n      let resJson: any = null;\n      try {\n        resJson = JSON.parse(text);\n      } catch {\n        resJson = { raw: text };\n      }\n\n      if (!response.ok) {\n        return {\n          success: false,\n          error: `AMR System tr\341\272\243 m\303\243 l\341\273\227i HTTP ${response.status}: ${text}`,\n          httpStatus: response.status,\n          durationMs,\n        };\n      }\n\n      return {\n        success: true,\n        data: resJson,\n        durationMs,\n      };\n    } catch (err: any) {\n      clearTimeout(timeoutId);\n      const durationMs = Date.now() - startTime;\n      if (err.name === \'AbortError\') {\n        return {\n          success: false,\n          error: `AMR System qu\303\241 th\341\273\235i gian ch\341\273\235 (Timeout sau ${timeoutMs}ms)`,\n          durationMs,\n        };\n      }\n      return {\n        success: false,\n        error: `Kh\303\264ng th\341\273\203 k\341\272\277t n\341\273\221i \304\221\341\272\277n AMR System (${baseUrl}): ${err.message}`,\n        durationMs,\n      };\n    }\n  }\n\n  /**\n   * Send Trigger to AMR System\n   */\n  public async sendTrigger(payload: AmrTriggerPayload): Promise<{\n    success: boolean;\n    data?: any;\n    error?: string;\n    httpStatus?: number;\n    durationMs: number;\n  }> {\n    const startTime = Date.now();\n    const { baseUrl, triggerPath, timeoutMs, mockMode } = this.config.amrSystem;\n\n    if (mockMode) {\n      await new Promise((resolve) => setTimeout(resolve, 300));\n      const durationMs = Date.now() - startTime;\n\n      if (this.simulateFailure === \'amr_down\') {\n        return {\n          success: false,\n          error: \'AMR System kh\303\264ng ph\341\272\243n h\341\273\223i khi g\341\273\255i Trigger (M\303\264 ph\341\273\217ng ng\341\272\257t k\341\272\277t n\341\273\221i)\',\n          durationMs,\n        };\n      }\n\n      if (this.simulateFailure === \'amr_reject\') {\n        return {\n          success: false,\n          error: \'AMR System t\341\273\253 ch\341\273\221i Trigger: \304\220i\341\273\203m currentStation kh\303\264ng kh\341\273\233p v\341\273\233i \304\221i\341\273\203m ch\341\273\235 hi\341\273\207n t\341\272\241i\',\n          httpStatus: 400,\n          durationMs,\n        };\n      }\n\n      return {\n        success: true,\n        data: {\n          code: 0,\n          msg: `Trigger station ${payload.currentStation} successful`,\n        },\n        durationMs,\n      };\n    }\n\n    // Real HTTP call to AMR System\n    const controller = new AbortController();\n    const timeoutId = setTimeout(() => controller.abort(), timeoutMs || 5000);\n    const targetUrl = `${baseUrl.replace(/\\/+$/, \'\')}${triggerPath}`;\n\n    try {\n      const response = await fetch(targetUrl, {\n        method: \'POST\',\n        headers: {\n          \'Content-Type\': \'application/json\',\n        },\n        body: JSON.stringify(payload),\n        signal: controller.signal,\n      });\n\n      clearTimeout(timeoutId);\n      const durationMs = Date.now() - startTime;\n      const text = await response.text();\n      let resJson: any = null;\n      try {\n        resJson = JSON.parse(text);\n      } catch {\n        resJson = { raw: text };\n      }\n\n      if (!response.ok) {\n        return {\n          success: false,\n          error: `AMR System tr\341\272\243 m\303\243 l\341\273\227i HTTP ${response.status}: ${text}`,\n          httpStatus: response.status,\n          durationMs,\n        };\n      }\n\n      return {\n        success: true,\n        data: resJson,\n        durationMs,\n      };\n    } catch (err: any) {\n      clearTimeout(timeoutId);\n      const durationMs = Date.now() - startTime;\n      if (err.name === \'AbortError\') {\n        return {\n          success: false,\n          error: `Trigger qu\303\241 th\341\273\235i gian ch\341\273\235 (Timeout sau ${timeoutMs}ms)`,\n          durationMs,\n        };\n      }\n      return {\n        success: false,\n        error: `Kh\303\264ng th\341\273\203 k\341\272\277t n\341\273\221i g\341\273\255i Trigger \304\221\341\272\277n AMR System (${baseUrl}): ${err.message}`,\n        durationMs,\n      };\n    }\n  }\n}\n\nexport const amrClient = new AmrClientService();\n"
    }
