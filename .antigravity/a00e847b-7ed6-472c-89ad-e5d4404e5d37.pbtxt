    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { ActivityLog } from \'../types\';\nimport { api } from \'../services/api\';\nimport { X, RefreshCw, Terminal, CheckCircle, XCircle, AlertCircle, PlayCircle } from \'lucide-react\';\n\ninterface LogsDrawerProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const LogsDrawer: React.FC<LogsDrawerProps> = ({ isOpen, onClose }) => {\n  const [logs, setLogs] = useState<ActivityLog[]>([]);\n  const [loading, setLoading] = useState(false);\n  const [simMode, setSimMode] = useState<\'none\' | \'amr_down\' | \'amr_reject\'>(\'none\');\n  const [activeTab, setActiveTab] = useState<\'logs\' | \'test\'>(\'logs\');\n\n  const loadLogs = async () => {\n    setLoading(true);\n    try {\n      const res = await api.getLogs();\n      if (res.success && res.data) {\n        setLogs(res.data);\n      }\n    } catch (err) {\n      console.error(\'L\341\273\227i khi t\341\272\243i logs:\', err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    if (isOpen) {\n      loadLogs();\n    }\n  }, [isOpen]);\n\n  const handleSimModeChange = async (mode: \'none\' | \'amr_down\' | \'amr_reject\') => {\n    try {\n      await api.setSimulationMode(mode);\n      setSimMode(mode);\n      loadLogs();\n    } catch (err) {\n      console.error(\'L\341\273\227i khi set simulation mode:\', err);\n    }\n  };\n\n  if (!isOpen) return null;\n\n  return (\n    <div\n      id=\"logs-drawer-overlay\"\n      className=\"fixed inset-0 z-50 flex justify-end bg-black/60 backdrop-blur-xs\"\n    >\n      <div\n        id=\"logs-drawer-panel\"\n        className=\"w-full max-w-lg bg-slate-900 border-l border-slate-700 h-full flex flex-col text-slate-100 shadow-2xl\"\n      >\n        {/* Header */}\n        <div className=\"p-4 border-b border-slate-800 flex items-center justify-between bg-slate-950\">\n          <div className=\"flex items-center gap-2\">\n            <Terminal className=\"w-5 h-5 text-sky-400\" />\n            <h3 className=\"font-bold text-base text-white\">AMR Communication & State Logs</h3>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              id=\"refresh-logs-btn\"\n              onClick={loadLogs}\n              disabled={loading}\n              className=\"p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300\"\n              title=\"L\303\240m m\341\273\233i\"\n            >\n              <RefreshCw className={`w-4 h-4 ${loading ? \'animate-spin\' : \'\'}`} />\n            </button>\n            <button\n              id=\"close-logs-btn\"\n              onClick={onClose}\n              className=\"p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300\"\n              title=\"\304\220\303\263ng\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Tab switch */}\n        <div className=\"flex border-b border-slate-800 bg-slate-900/60 p-2 gap-2 text-sm\">\n          <button\n            onClick={() => setActiveTab(\'logs\')}\n            className={`flex-1 py-2 px-3 rounded-lg font-medium transition-colors ${\n              activeTab === \'logs\'\n                ? \'bg-slate-800 text-sky-400 border border-slate-700\'\n                : \'text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            L\341\273\213ch s\341\273\255 giao ti\341\272\277p ({logs.length})\n          </button>\n          <button\n            onClick={() => setActiveTab(\'test\')}\n            className={`flex-1 py-2 px-3 rounded-lg font-medium transition-colors ${\n              activeTab === \'test\'\n                ? \'bg-slate-800 text-amber-400 border border-slate-700\'\n                : \'text-slate-400 hover:text-slate-200\'\n            }`}\n          >\n            Gi\341\272\243 l\341\272\255p l\341\273\227i (Test Error)\n          </button>\n        </div>\n\n        {/* Content */}\n        <div className=\"flex-1 overflow-y-auto p-4 space-y-3\">\n          {activeTab === \'test\' ? (\n            <div className=\"space-y-4\">\n              <div className=\"p-4 bg-slate-800/80 border border-slate-700 rounded-xl space-y-2\">\n                <h4 className=\"font-semibold text-white text-sm\">Ch\341\272\277 \304\221\341\273\231 ki\341\273\203m th\341\273\255 l\341\273\227i AMR System (Phase 7):</h4>\n                <p className=\"text-xs text-slate-300 leading-relaxed\">\n                  Cho ph\303\251p b\341\272\241n ki\341\273\203m tra ph\341\272\243n \341\273\251ng c\341\273\247a Web Control Panel v\303\240 PDA khi AMR System g\341\272\267p s\341\273\261 c\341\273\221:\n                </p>\n\n                <div className=\"space-y-2 pt-2\">\n                  <label className=\"flex items-center gap-3 p-2.5 rounded-lg bg-slate-900 border border-slate-700 cursor-pointer\">\n                    <input\n                      type=\"radio\"\n                      name=\"simMode\"\n                      value=\"none\"\n                      checked={simMode === \'none\'}\n                      onChange={() => handleSimModeChange(\'none\')}\n                      className=\"text-sky-500 focus:ring-sky-500\"\n                    />\n                    <div>\n                      <div className=\"text-sm font-medium text-white\">B\303\254nh th\306\260\341\273\235ng (Normal Success)</div>\n                      <div className=\"text-xs text-slate-400\">Ph\341\272\243n h\341\273\223i 200 OK t\341\273\253 AMR System</div>\n                    </div>\n                  </label>\n\n                  <label className=\"flex items-center gap-3 p-2.5 rounded-lg bg-slate-900 border border-slate-700 cursor-pointer\">\n                    <input\n                      type=\"radio\"\n                      name=\"simMode\"\n                      value=\"amr_down\"\n                      checked={simMode === \'amr_down\'}\n                      onChange={() => handleSimModeChange(\'amr_down\')}\n                      className=\"text-amber-500 focus:ring-amber-500\"\n                    />\n                    <div>\n                      <div className=\"text-sm font-medium text-amber-300\">AMR M\341\272\245t k\341\272\277t n\341\273\221i (AMR Down / Timeout)</div>\n                      <div className=\"text-xs text-slate-400\">M\303\264 ph\341\273\217ng \304\221\341\273\251t c\303\241p, m\341\272\241ng s\341\272\255p ho\341\272\267c kh\303\264ng ph\341\272\243n h\341\273\223i</div>\n                    </div>\n                  </label>\n\n                  <label className=\"flex items-center gap-3 p-2.5 rounded-lg bg-slate-900 border border-slate-700 cursor-pointer\">\n                    <input\n                      type=\"radio\"\n                      name=\"simMode\"\n                      value=\"amr_reject\"\n                      checked={simMode === \'amr_reject\'}\n                      onChange={() => handleSimModeChange(\'amr_reject\')}\n                      className=\"text-red-500 focus:ring-red-500\"\n                    />\n                    <div>\n                      <div className=\"text-sm font-medium text-red-300\">AMR T\341\273\253 ch\341\273\221i l\341\273\207nh (AMR Rejected)</div>\n                      <div className=\"text-xs text-slate-400\">M\303\264 ph\341\273\217ng robot \304\221ang l\341\273\227i, E-stop ho\341\272\267c \304\221i\341\273\203m ch\341\273\235 kh\303\264ng kh\341\273\233p</div>\n                    </div>\n                  </label>\n                </div>\n              </div>\n            </div>\n          ) : logs.length === 0 ? (\n            <div className=\"text-center py-12 text-slate-400 text-sm\">\n              Ch\306\260a c\303\263 s\341\273\261 ki\341\273\207n n\303\240o. H\303\243y th\341\273\261c hi\341\273\207n b\341\272\245m G\341\273\214I L\341\273\206NH ho\341\272\267c TRIGGER.\n            </div>\n          ) : (\n            logs.map((log) => (\n              <div\n                key={log.id}\n                className=\"p-3 bg-slate-800/70 border border-slate-700/80 rounded-xl space-y-2 text-xs\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-1.5 font-semibold\">\n                    {log.success ? (\n                      <CheckCircle className=\"w-4 h-4 text-emerald-400\" />\n                    ) : (\n                      <XCircle className=\"w-4 h-4 text-rose-400\" />\n                    )}\n                    <span\n                      className={`px-1.5 py-0.5 rounded text-[11px] font-mono uppercase ${\n                        log.type === \'ORDER\'\n                          ? \'bg-blue-500/20 text-blue-300\'\n                          : log.type === \'TRIGGER\'\n                          ? \'bg-emerald-500/20 text-emerald-300\'\n                          : log.type === \'RESET\'\n                          ? \'bg-amber-500/20 text-amber-300\'\n                          : \'bg-rose-500/20 text-rose-300\'\n                      }`}\n                    >\n                      {log.type}\n                    </span>\n                    <span className=\"text-slate-300\">\n                      {log.line.toUpperCase()}{log.station ? ` / ${log.station.toUpperCase()}` : \'\'}\n                    </span>\n                  </div>\n                  <span className=\"text-slate-400 font-mono text-[10px]\">\n                    {new Date(log.timestamp).toLocaleTimeString()}\n                  </span>\n                </div>\n\n                <div className=\"text-slate-200\">{log.message}</div>\n\n                {log.orderId && (\n                  <div className=\"font-mono text-[11px] text-sky-300 bg-slate-900/80 px-2 py-1 rounded\">\n                    orderId: {log.orderId}\n                  </div>\n                )}\n\n                {log.durationMs !== undefined && (\n                  <div className=\"text-slate-400 text-[10px]\">\n                    Th\341\273\235i gian ph\341\272\243n h\341\273\223i: {log.durationMs}ms\n                  </div>\n                )}\n\n                {log.payload && (\n                  <details className=\"text-[10px] text-slate-400\">\n                    <summary className=\"cursor-pointer hover:text-slate-200\">Xem chi ti\341\272\277t Payload</summary>\n                    <pre className=\"mt-1 p-2 bg-slate-950 rounded text-slate-300 overflow-x-auto font-mono text-[10px]\">\n                      {JSON.stringify(log.payload, null, 2)}\n                    </pre>\n                  </details>\n                )}\n              </div>\n            ))\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
