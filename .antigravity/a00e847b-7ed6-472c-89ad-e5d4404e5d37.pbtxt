    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { StationConfig, LineState } from \'../types\';\nimport { api } from \'../services/api\';\nimport { ConfirmModal } from \'./ConfirmModal\';\nimport {\n  Send,\n  Zap,\n  RotateCcw,\n  CheckCircle2,\n  AlertCircle,\n  Clock,\n  Wifi,\n  WifiOff,\n  Sliders,\n  ChevronLeft,\n} from \'lucide-react\';\n\ninterface StationControlProps {\n  lineKey: string;\n  stationKey: string;\n  onNavigateHome: () => void;\n  onOpenLogs: () => void;\n}\n\nexport const StationControl: React.FC<StationControlProps> = ({\n  lineKey,\n  stationKey,\n  onNavigateHome,\n  onOpenLogs,\n}) => {\n  const [config, setConfig] = useState<StationConfig | null>(null);\n  const [lineState, setLineState] = useState<LineState | null>(null);\n  const [loadingConfig, setLoadingConfig] = useState(true);\n  const [configError, setConfigError] = useState<string | null>(null);\n\n  // Action states\n  const [isOrdering, setIsOrdering] = useState(false);\n  const [isTriggering, setIsTriggering] = useState(false);\n  const [isResetting, setIsResetting] = useState(false);\n\n  // Modals\n  const [showOrderConfirm, setShowOrderConfirm] = useState(false);\n  const [showResetConfirm, setShowResetConfirm] = useState(false);\n\n  // Notification Banner\n  const [feedback, setFeedback] = useState<{\n    type: \'success\' | \'error\';\n    title: string;\n    message: string;\n    orderId?: string;\n  } | null>(null);\n\n  // Connectivity\n  const [isOnline, setIsOnline] = useState(true);\n  const isMountedRef = useRef(true);\n\n  // Fetch initial config\n  const fetchConfig = async () => {\n    try {\n      setLoadingConfig(true);\n      setConfigError(null);\n      const res = await api.getStationConfig(lineKey, stationKey);\n      if (res.success && res.data) {\n        setConfig(res.data);\n      } else {\n        setConfigError(res.message || \'Kh\303\264ng th\341\273\203 t\341\272\243i c\341\272\245u h\303\254nh station\');\n      }\n    } catch (err: any) {\n      setConfigError(\'Kh\303\264ng th\341\273\203 k\341\272\277t n\341\273\221i \304\221\341\272\277n Backend: \' + err.message);\n    } finally {\n      setLoadingConfig(false);\n    }\n  };\n\n  // Poll Line State (Decision 3 - Option A)\n  const pollState = async () => {\n    try {\n      const res = await api.getLineState(lineKey);\n      if (res.success && res.data) {\n        setLineState(res.data);\n        setIsOnline(true);\n      }\n    } catch (err) {\n      setIsOnline(false);\n    }\n  };\n\n  useEffect(() => {\n    isMountedRef.current = true;\n    fetchConfig();\n    pollState();\n\n    // Short polling every 2.5s for multi-PDA synchronization\n    const timer = setInterval(() => {\n      if (isMountedRef.current) {\n        pollState();\n      }\n    }, 2500);\n\n    return () => {\n      isMountedRef.current = false;\n      clearInterval(timer);\n    };\n  }, [lineKey, stationKey]);\n\n  // Execute Order (after confirmation)\n  const handleConfirmOrder = async () => {\n    if (!config) return;\n    setIsOrdering(true);\n    setShowOrderConfirm(false);\n    setFeedback(null);\n\n    try {\n      const res = await api.sendOrder(lineKey, stationKey);\n      if (res.success) {\n        setFeedback({\n          type: \'success\',\n          title: \'G\341\273\214I L\341\273\206NH TH\303\200NH C\303\224NG\',\n          message: `\304\220\303\243 ph\303\241t l\341\273\207nh t\341\273\233i AMR System (${res.durationMs || 0}ms)`,\n          orderId: res.orderId,\n        });\n        // Immediately refresh state\n        pollState();\n      } else {\n        setFeedback({\n          type: \'error\',\n          title: res.errorCode === \'LINE_LOCKED\' ? \'LINE \304\220ANG B\341\273\212 KH\303\223A\' : \'G\341\273\214I L\341\273\206NH TH\341\272\244T B\341\272\240I\',\n          message: res.message || \'L\341\273\227i kh\303\264ng x\303\241c \304\221\341\273\213nh khi g\341\273\255i l\341\273\207nh\',\n          orderId: res.orderId,\n        });\n        pollState();\n      }\n    } catch (err: any) {\n      setFeedback({\n        type: \'error\',\n        title: \'L\341\273\226I K\341\272\276T N\341\273\220I BACKEND\',\n        message: \'Kh\303\264ng th\341\273\203 li\303\252n l\341\272\241c v\341\273\233i Small Backend: \' + err.message,\n      });\n    } finally {\n      setIsOrdering(false);\n    }\n  };\n\n  // Execute Trigger\n  const handleTrigger = async () => {\n    if (!config) return;\n    setIsTriggering(true);\n    setFeedback(null);\n\n    try {\n      const res = await api.sendTrigger(lineKey, stationKey);\n      if (res.success) {\n        setFeedback({\n          type: \'success\',\n          title: \'TRIGGER TH\303\200NH C\303\224NG\',\n          message: `\304\220\303\243 k\303\255ch ho\341\272\241t \304\221i\341\273\203m ${res.currentStation} cho AMR (${res.durationMs || 0}ms)`,\n        });\n      } else {\n        setFeedback({\n          type: \'error\',\n          title: \'TRIGGER TH\341\272\244T B\341\272\240I\',\n          message: res.message || \'L\341\273\227i khi k\303\255ch ho\341\272\241t Trigger\',\n        });\n      }\n    } catch (err: any) {\n      setFeedback({\n        type: \'error\',\n        title: \'L\341\273\226I K\341\272\276T N\341\273\220I\',\n        message: \'Kh\303\264ng th\341\273\203 g\341\273\255i Trigger \304\221\341\272\277n Backend: \' + err.message,\n      });\n    } finally {\n      setIsTriggering(false);\n    }\n  };\n\n  // Execute Reset (Decision 1 Option A)\n  const handleConfirmReset = async () => {\n    setIsResetting(true);\n    setShowResetConfirm(false);\n\n    try {\n      const res = await api.resetLine(lineKey);\n      if (res.success) {\n        setFeedback({\n          type: \'success\',\n          title: \'\304\220\303\203 M\341\273\236 KH\303\223A LINE\',\n          message: `\304\220\303\243 \304\221\306\260a ${config?.lineName || lineKey.toUpperCase()} v\341\273\201 tr\341\272\241ng th\303\241i IDLE s\341\272\265n s\303\240ng`,\n        });\n        pollState();\n      } else {\n        setFeedback({\n          type: \'error\',\n          title: \'RESET TH\341\272\244T B\341\272\240I\',\n          message: res.message || \'Kh\303\264ng th\341\273\203 m\341\273\237 kh\303\263a\',\n        });\n      }\n    } catch (err: any) {\n      setFeedback({\n        type: \'error\',\n        title: \'L\341\273\226I K\341\272\276T N\341\273\220I\',\n        message: err.message,\n      });\n    } finally {\n      setIsResetting(false);\n    }\n  };\n\n  if (loadingConfig) {\n    return (\n      <div className=\"flex flex-col items-center justify-center min-h-[70vh] p-6 text-center\">\n        <div className=\"w-12 h-12 border-4 border-blue-500/30 border-t-blue-500 rounded-full animate-spin mb-4\" />\n        <div className=\"text-lg font-bold text-slate-100\">\304\220ang t\341\272\243i c\341\272\245u h\303\254nh Station...</div>\n        <div className=\"text-sm text-slate-400 mt-1 font-mono\">{lineKey} / {stationKey}</div>\n      </div>\n    );\n  }\n\n  if (configError || !config) {\n    return (\n      <div className=\"p-6 max-w-md mx-auto text-center space-y-4\">\n        <div className=\"w-16 h-16 bg-rose-500/20 text-rose-400 rounded-2xl flex items-center justify-center mx-auto\">\n          <AlertCircle className=\"w-8 h-8\" />\n        </div>\n        <h2 className=\"text-xl font-bold text-white\">Kh\303\264ng t\303\254m th\341\272\245y Station</h2>\n        <p className=\"text-sm text-slate-300 bg-slate-900 p-4 rounded-xl border border-slate-800\">\n          {configError}\n        </p>\n        <button\n          onClick={onNavigateHome}\n          className=\"w-full min-h-[50px] px-4 py-2 bg-blue-600 hover:bg-blue-700 font-bold rounded-xl text-white\"\n        >\n          Quay l\341\272\241i danh s\303\241ch Station\n        </button>\n      </div>\n    );\n  }\n\n  const isLineRunning = lineState?.status === \'running\';\n\n  return (\n    <div className=\"w-full max-w-md mx-auto flex flex-col min-h-[92vh] justify-between pb-4\">\n      {/* 1. Station Header Bar */}\n      <div className=\"space-y-3\">\n        <div className=\"flex items-center justify-between gap-2 pb-2 border-b border-slate-800\">\n          <button\n            id=\"back-to-stations-btn\"\n            onClick={onNavigateHome}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-xs font-semibold text-slate-300\"\n          >\n            <ChevronLeft className=\"w-4 h-4\" />\n            <span>\304\220\341\273\225i Station</span>\n          </button>\n\n          <div className=\"flex items-center gap-2 text-xs\">\n            <button\n              id=\"open-logs-btn\"\n              onClick={onOpenLogs}\n              className=\"flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 font-mono\"\n              title=\"Xem nh\341\272\255t k\303\275 giao ti\341\272\277p\"\n            >\n              <Sliders className=\"w-3.5 h-3.5\" />\n              <span>Logs</span>\n            </button>\n\n            <span\n              className={`flex items-center gap-1 px-2.5 py-1.5 rounded-lg font-semibold ${\n                isOnline\n                  ? \'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30\'\n                  : \'bg-rose-500/15 text-rose-400 border border-rose-500/30\'\n              }`}\n            >\n              {isOnline ? (\n                <>\n                  <Wifi className=\"w-3.5 h-3.5 animate-pulse\" />\n                  <span>Online</span>\n                </>\n              ) : (\n                <>\n                  <WifiOff className=\"w-3.5 h-3.5\" />\n                  <span>M\341\272\245t m\341\272\241ng</span>\n                </>\n              )}\n            </span>\n          </div>\n        </div>\n\n        {/* Station Title Banner - High Readability for PDA */}\n        <div\n          id=\"station-header-card\"\n          className=\"bg-slate-900 border-2 border-slate-700/80 rounded-2xl p-4 shadow-lg\"\n        >\n          <div className=\"flex items-start justify-between\">\n            <div>\n              <div className=\"text-xs font-bold uppercase tracking-wider text-sky-400\">\n                {config.lineName}\n              </div>\n              <h1 className=\"text-2xl font-black tracking-tight text-white mt-0.5\">\n                {config.stationName.toUpperCase()}{\' \'}\n                <span className=\"text-sky-400 text-xl font-mono\">({config.stationCode})</span>\n              </h1>\n            </div>\n\n            {/* Line Status Badge */}\n            <div className=\"text-right\">\n              <span\n                id=\"line-status-badge\"\n                className={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider shadow-xs ${\n                  isLineRunning\n                    ? \'bg-amber-500 text-slate-950 font-black animate-pulse\'\n                    : \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40\'\n                }`}\n              >\n                <span\n                  className={`w-2 h-2 rounded-full ${\n                    isLineRunning ? \'bg-slate-950\' : \'bg-emerald-400\'\n                  }`}\n                />\n                {isLineRunning ? \'\304\220ANG CH\341\272\240Y\' : \'S\341\272\264N S\303\200NG\'}\n              </span>\n              {isLineRunning && lineState?.currentOrderId && (\n                <div className=\"text-[10px] text-amber-300 font-mono mt-1 truncate max-w-[150px]\">\n                  {lineState.currentOrderId}\n                </div>\n              )}\n            </div>\n          </div>\n\n          {/* Config Parameters Display */}\n          <div className=\"mt-3 pt-3 border-t border-slate-800/80 grid grid-cols-2 gap-2 text-xs\">\n            <div className=\"bg-slate-950/70 p-2 rounded-lg border border-slate-800\">\n              <span className=\"text-slate-400 block text-[10px]\">L\341\273\207nh chung:</span>\n              <span className=\"text-slate-200 font-bold\">{config.orderLabel}</span>\n            </div>\n            <div className=\"bg-slate-950/70 p-2 rounded-lg border border-slate-800\">\n              <span className=\"text-slate-400 block text-[10px]\">\304\220i\341\273\203m Trigger:</span>\n              <span className=\"text-emerald-400 font-mono font-bold\">{config.triggerStation}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* 2. Notification / Feedback Banner */}\n        {feedback && (\n          <div\n            id=\"station-feedback-banner\"\n            className={`p-3.5 rounded-xl border flex items-start gap-3 transition-all ${\n              feedback.type === \'success\'\n                ? \'bg-emerald-950/60 border-emerald-600/60 text-emerald-100\'\n                : \'bg-rose-950/60 border-rose-600/60 text-rose-100\'\n            }`}\n          >\n            {feedback.type === \'success\' ? (\n              <CheckCircle2 className=\"w-5 h-5 text-emerald-400 shrink-0 mt-0.5\" />\n            ) : (\n              <AlertCircle className=\"w-5 h-5 text-rose-400 shrink-0 mt-0.5\" />\n            )}\n            <div className=\"flex-1 text-xs\">\n              <div className=\"font-bold text-sm\">{feedback.title}</div>\n              <div className=\"mt-0.5 text-slate-200 leading-relaxed\">{feedback.message}</div>\n              {feedback.orderId && (\n                <div className=\"mt-1 font-mono text-[11px] text-sky-300 bg-slate-900/80 px-2 py-1 rounded inline-block\">\n                  ID: {feedback.orderId}\n                </div>\n              )}\n            </div>\n            <button\n              onClick={() => setFeedback(null)}\n              className=\"text-slate-400 hover:text-white text-xs px-1\"\n            >\n              \342\234\225\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* 3. PRIMARY ACTION BUTTONS (PDA Optimized Vertical Stack) */}\n      <div className=\"my-6 space-y-4\">\n        {/* ACTION 1: G\341\273\214I L\341\273\206NH */}\n        <div className=\"space-y-1\">\n          <button\n            id=\"order-action-btn\"\n            type=\"button\"\n            disabled={isLineRunning || isOrdering}\n            onClick={() => setShowOrderConfirm(true)}\n            className={`w-full min-h-[78px] px-6 py-4 rounded-2xl font-black text-xl tracking-wide uppercase transition-all duration-150 flex flex-col items-center justify-center gap-1 shadow-xl border-2 ${\n              isLineRunning\n                ? \'bg-slate-800/90 text-slate-500 border-slate-700 cursor-not-allowed shadow-none\'\n                : \'bg-blue-600 hover:bg-blue-500 active:scale-[0.98] text-white border-blue-400/50 hover:border-blue-300\'\n            }`}\n          >\n            <div className=\"flex items-center gap-2\">\n              <Send className=\"w-6 h-6\" />\n              <span>G\341\273\214I {config.orderLabel.toUpperCase()}</span>\n            </div>\n            <span className=\"text-[11px] font-medium tracking-normal normal-case opacity-80\">\n              {isLineRunning\n                ? \'N\303\272t b\341\273\213 kh\303\263a v\303\254 Line \304\221ang ch\341\272\241y l\341\273\207nh\'\n                : \'Y\303\252u c\341\272\247u AMR xu\341\272\245t ph\303\241t di chuy\341\273\203n\'}\n            </span>\n          </button>\n        </div>\n\n        {/* ACTION 2: TRIGGER */}\n        <div className=\"space-y-1\">\n          <button\n            id=\"trigger-action-btn\"\n            type=\"button\"\n            disabled={isTriggering}\n            onClick={handleTrigger}\n            className=\"w-full min-h-[78px] px-6 py-4 rounded-2xl font-black text-xl tracking-wide uppercase bg-emerald-600 hover:bg-emerald-500 active:scale-[0.98] text-white border-2 border-emerald-400/50 hover:border-emerald-300 transition-all duration-150 flex flex-col items-center justify-center gap-1 shadow-xl\"\n          >\n            <div className=\"flex items-center gap-2\">\n              {isTriggering ? (\n                <span className=\"w-6 h-6 border-3 border-white/30 border-t-white rounded-full animate-spin\" />\n              ) : (\n                <Zap className=\"w-6 h-6\" />\n              )}\n              <span>TRIGGER {config.stationCode}</span>\n            </div>\n            <span className=\"text-[11px] font-medium tracking-normal normal-case opacity-80 font-mono\">\n              currentStation: {config.triggerStation}\n            </span>\n          </button>\n        </div>\n      </div>\n\n      {/* 4. UTILITY / RESET ACTION (Decision 1 - Option A) */}\n      <div className=\"pt-3 border-t border-slate-800/80 space-y-2\">\n        <div className=\"flex items-center justify-between text-xs text-slate-400 px-1\">\n          <span>Qu\341\272\243n tr\341\273\213 Line:</span>\n          <span className=\"font-mono\">\n            Line {config.lineName.replace(\'Line \', \'\')} ({isLineRunning ? \'Locked\' : \'Idle\'})\n          </span>\n        </div>\n\n        <button\n          id=\"reset-line-btn\"\n          type=\"button\"\n          disabled={isResetting}\n          onClick={() => setShowResetConfirm(true)}\n          className={`w-full min-h-[48px] px-4 py-2.5 rounded-xl font-bold text-sm transition-colors flex items-center justify-center gap-2 border ${\n            isLineRunning\n              ? \'bg-amber-600/20 hover:bg-amber-600/30 text-amber-300 border-amber-500/40\'\n              : \'bg-slate-800/60 hover:bg-slate-800 text-slate-400 border-slate-700/50\'\n          }`}\n        >\n          <RotateCcw className={`w-4 h-4 ${isResetting ? \'animate-spin\' : \'\'}`} />\n          <span>M\341\273\236 KH\303\223A / RESET {config.lineName.toUpperCase()}</span>\n        </button>\n      </div>\n\n      {/* 5. Confirmation Modals */}\n      {/* G\341\273\214I L\341\273\206NH Confirm Modal (Requirement Section 14) */}\n      <ConfirmModal\n        isOpen={showOrderConfirm}\n        title=\"X\303\201C NH\341\272\254N G\341\273\214I L\341\273\206NH\"\n        message={`B\341\272\241n c\303\263 ch\341\272\257c mu\341\273\221n g\341\273\215i ${config.orderLabel} cho ${config.lineName} kh\303\264ng? (Thao t\303\241c n\303\240y s\341\272\275 g\341\273\255i l\341\273\207nh di chuy\341\273\203n t\341\273\233i AMR System v\303\240 kh\303\263a n\303\272t g\341\273\215i c\341\273\247a Line).`}\n        confirmText=\"X\303\201C NH\341\272\254N\"\n        cancelText=\"H\341\273\246Y\"\n        variant=\"primary\"\n        isLoading={isOrdering}\n        onConfirm={handleConfirmOrder}\n        onCancel={() => setShowOrderConfirm(false)}\n      />\n\n      {/* RESET Line Confirm Modal (Decision 1 Option A) */}\n      <ConfirmModal\n        isOpen={showResetConfirm}\n        title=\"X\303\201C NH\341\272\254N M\341\273\236 KH\303\223A LINE\"\n        message={`B\341\272\241n c\303\263 ch\341\272\257c mu\341\273\221n m\341\273\237 kh\303\263a ${config.lineName} v\341\273\201 tr\341\272\241ng th\303\241i IDLE kh\303\264ng? N\303\272t G\341\273\214I L\341\273\206NH s\341\272\275 \304\221\306\260\341\273\243c k\303\255ch ho\341\272\241t l\341\272\241i cho c\341\272\243 2 Station c\341\273\247a Line.`}\n        confirmText=\"M\341\273\236 KH\303\223A\"\n        cancelText=\"H\341\273\246Y\"\n        variant=\"warning\"\n        isLoading={isResetting}\n        onConfirm={handleConfirmReset}\n        onCancel={() => setShowResetConfirm(false)}\n      />\n    </div>\n  );\n};\n"
    }
