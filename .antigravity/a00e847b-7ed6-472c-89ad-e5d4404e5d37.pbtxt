    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { StationControl } from \'./StationControl\';\nimport { Smartphone, Monitor } from \'lucide-react\';\n\ninterface MultiPdaViewProps {\n  onOpenLogs: () => void;\n}\n\nexport const MultiPdaView: React.FC<MultiPdaViewProps> = ({ onOpenLogs }) => {\n  const [selectedPair, setSelectedPair] = useState<\'line-a\' | \'line-b\' | \'all\'>(\'line-a\');\n\n  return (\n    <div className=\"w-full max-w-6xl mx-auto space-y-4 pb-8\">\n      <div className=\"flex flex-wrap items-center justify-between gap-3 p-4 bg-slate-900 border border-slate-800 rounded-2xl\">\n        <div>\n          <h2 className=\"text-lg font-bold text-white flex items-center gap-2\">\n            <Monitor className=\"w-5 h-5 text-sky-400\" />\n            M\303\264 ph\341\273\217ng \304\220a PDA \304\220\341\273\223ng th\341\273\235i (Multi-Device Simulator)\n          </h2>\n          <p className=\"text-xs text-slate-400\">\n            D\303\271ng \304\221\341\273\203 ki\341\273\203m th\341\273\255 t\303\255nh n\304\203ng kh\303\263a ch\303\251o n\303\272t G\341\273\214I L\341\273\206NH (Line Locking) gi\341\273\257a c\303\241c Station c\303\271ng Line\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 text-xs\">\n          <button\n            onClick={() => setSelectedPair(\'line-a\')}\n            className={`px-3 py-1.5 rounded-lg font-medium transition-colors ${\n              selectedPair === \'line-a\'\n                ? \'bg-blue-600 text-white\'\n                : \'bg-slate-800 text-slate-300 hover:bg-slate-700\'\n            }`}\n          >\n            Line A (A1 + A2)\n          </button>\n          <button\n            onClick={() => setSelectedPair(\'line-b\')}\n            className={`px-3 py-1.5 rounded-lg font-medium transition-colors ${\n              selectedPair === \'line-b\'\n                ? \'bg-blue-600 text-white\'\n                : \'bg-slate-800 text-slate-300 hover:bg-slate-700\'\n            }`}\n          >\n            Line B (B1 + B2)\n          </button>\n          <button\n            onClick={() => setSelectedPair(\'all\')}\n            className={`px-3 py-1.5 rounded-lg font-medium transition-colors ${\n              selectedPair === \'all\'\n                ? \'bg-blue-600 text-white\'\n                : \'bg-slate-800 text-slate-300 hover:bg-slate-700\'\n            }`}\n          >\n            T\341\272\245t c\341\272\243 4 Station\n          </button>\n        </div>\n      </div>\n\n      <div\n        className={`grid gap-6 ${\n          selectedPair === \'all\'\n            ? \'grid-cols-1 md:grid-cols-2 lg:grid-cols-4\'\n            : \'grid-cols-1 md:grid-cols-2\'\n        }`}\n      >\n        {(selectedPair === \'line-a\' || selectedPair === \'all\') && (\n          <>\n            {/* PDA A1 */}\n            <div className=\"bg-slate-950 border-4 border-slate-800 rounded-3xl p-3 shadow-2xl relative overflow-hidden\">\n              <div className=\"text-center py-1 text-[11px] font-mono text-slate-400 border-b border-slate-800 mb-3 flex items-center justify-center gap-1.5\">\n                <Smartphone className=\"w-3.5 h-3.5 text-sky-400\" />\n                <span>PDA #1: /control/line-a/pickup</span>\n              </div>\n              <StationControl\n                lineKey=\"line-a\"\n                stationKey=\"pickup\"\n                onNavigateHome={() => {}}\n                onOpenLogs={onOpenLogs}\n              />\n            </div>\n\n            {/* PDA A2 */}\n            <div className=\"bg-slate-950 border-4 border-slate-800 rounded-3xl p-3 shadow-2xl relative overflow-hidden\">\n              <div className=\"text-center py-1 text-[11px] font-mono text-slate-400 border-b border-slate-800 mb-3 flex items-center justify-center gap-1.5\">\n                <Smartphone className=\"w-3.5 h-3.5 text-sky-400\" />\n                <span>PDA #2: /control/line-a/dropoff</span>\n              </div>\n              <StationControl\n                lineKey=\"line-a\"\n                stationKey=\"dropoff\"\n                onNavigateHome={() => {}}\n                onOpenLogs={onOpenLogs}\n              />\n            </div>\n          </>\n        )}\n\n        {(selectedPair === \'line-b\' || selectedPair === \'all\') && (\n          <>\n            {/* PDA B1 */}\n            <div className=\"bg-slate-950 border-4 border-slate-800 rounded-3xl p-3 shadow-2xl relative overflow-hidden\">\n              <div className=\"text-center py-1 text-[11px] font-mono text-slate-400 border-b border-slate-800 mb-3 flex items-center justify-center gap-1.5\">\n                <Smartphone className=\"w-3.5 h-3.5 text-sky-400\" />\n                <span>PDA #3: /control/line-b/pickup</span>\n              </div>\n              <StationControl\n                lineKey=\"line-b\"\n                stationKey=\"pickup\"\n                onNavigateHome={() => {}}\n                onOpenLogs={onOpenLogs}\n              />\n            </div>\n\n            {/* PDA B2 */}\n            <div className=\"bg-slate-950 border-4 border-slate-800 rounded-3xl p-3 shadow-2xl relative overflow-hidden\">\n              <div className=\"text-center py-1 text-[11px] font-mono text-slate-400 border-b border-slate-800 mb-3 flex items-center justify-center gap-1.5\">\n                <Smartphone className=\"w-3.5 h-3.5 text-sky-400\" />\n                <span>PDA #4: /control/line-b/dropoff</span>\n              </div>\n              <StationControl\n                lineKey=\"line-b\"\n                stationKey=\"dropoff\"\n                onNavigateHome={() => {}}\n                onOpenLogs={onOpenLogs}\n              />\n            </div>\n          </>\n        )}\n      </div>\n    </div>\n  );\n};\n"
