  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \'express\';\nimport path from \'path\';\nimport { createServer as createViteServer } from \'vite\';\nimport { amrClient } from \'./server/amrClient.js\';\nimport { stateManager } from \'./server/state.js\';\n\nasync function startServer() {\n  const app = express();\n  const PORT = 3000;\n\n  app.use(express.json());\n\n  // --- API ROUTES FIRST ---\n\n  /**\n   * GET /api/config\n   * Query params: line, station (optional)\n   * Returns config for specific station, or all stations if no params\n   */\n  app.get(\'/api/config\', (req, res) => {\n    try {\n      const config = amrClient.getConfig();\n      const lineKey = typeof req.query.line === \'string\' ? req.query.line.toLowerCase() : undefined;\n      const stationKey = typeof req.query.station === \'string\' ? req.query.station.toLowerCase() : undefined;\n\n      if (lineKey && stationKey) {\n        const line = config.lines[lineKey];\n        if (!line) {\n          return res.status(404).json({\n            success: false,\n            errorCode: \'LINE_NOT_FOUND\',\n            message: `Kh\303\264ng t\303\254m th\341\272\245y c\341\272\245u h\303\254nh cho Line \'${lineKey}\'`,\n          });\n        }\n\n        const station = line.stations[stationKey];\n        if (!station) {\n          return res.status(404).json({\n            success: false,\n            errorCode: \'STATION_NOT_FOUND\',\n            message: `Kh\303\264ng t\303\254m th\341\272\245y c\341\272\245u h\303\254nh cho Station \'${stationKey}\' thu\341\273\231c ${line.name}`,\n          });\n        }\n\n        return res.json({\n          success: true,\n          data: {\n            lineKey,\n            stationKey,\n            lineName: line.name,\n            stationName: station.name,\n            stationCode: station.code,\n            orderLabel: line.orderLabel || `L\341\273\207nh ${line.name}`,\n            taskPath: line.taskPath,\n            triggerStation: station.triggerStation,\n            mockMode: config.amrSystem.mockMode,\n          },\n        });\n      }\n\n      // Return full lines and stations hierarchy (for station selection / info)\n      return res.json({\n        success: true,\n        data: {\n          lines: Object.entries(config.lines).map(([key, val]) => ({\n            key,\n            name: val.name,\n            orderLabel: val.orderLabel,\n            taskPath: val.taskPath,\n            stations: Object.entries(val.stations).map(([sKey, sVal]) => ({\n              key: sKey,\n              code: sVal.code,\n              name: sVal.name,\n              triggerStation: sVal.triggerStation,\n              url: `/control/${key}/${sKey}`,\n            })),\n          })),\n          mockMode: config.amrSystem.mockMode,\n        },\n      });\n    } catch (err: any) {\n      return res.status(500).json({\n        success: false,\n        errorCode: \'SERVER_ERROR\',\n        message: err.message || \'L\341\273\227i \304\221\341\273\215c c\341\272\245u h\303\254nh h\341\273\207 th\341\273\221ng\',\n      });\n    }\n  });\n\n  /**\n   * GET /api/state\n   * Query param: line (optional)\n   * Returns shared line lock states for all or a specific line\n   */\n  app.get(\'/api/state\', (req, res) => {\n    try {\n      const lineKey = typeof req.query.line === \'string\' ? req.query.line.toLowerCase() : undefined;\n      if (lineKey) {\n        const state = stateManager.getLineState(lineKey);\n        return res.json({\n          success: true,\n          data: {\n            line: lineKey,\n            ...state,\n          },\n        });\n      }\n\n      return res.json({\n        success: true,\n        data: stateManager.getAllStates(),\n      });\n    } catch (err: any) {\n      return res.status(500).json({\n        success: false,\n        errorCode: \'SERVER_ERROR\',\n        message: err.message || \'L\341\273\227i ki\341\273\203m tra tr\341\272\241ng th\303\241i h\341\273\207 th\341\273\221ng\',\n      });\n    }\n  });\n\n  /**\n   * POST /api/order\n   * Body: { line: \"line-a\", station: \"pickup\" }\n   * Atomic check-and-lock, generates unique timestamp orderId, sends to AMR System\n   */\n  app.post(\'/api/order\', async (req, res) => {\n    const { line: lineKey, station: stationKey } = req.body || {};\n\n    if (!lineKey || !stationKey) {\n      return res.status(400).json({\n        success: false,\n        errorCode: \'INVALID_REQUEST\',\n        message: \'Y\303\252u c\341\272\247u thi\341\272\277u tham s\341\273\221 line ho\341\272\267c station.\',\n      });\n    }\n\n    const config = amrClient.getConfig();\n    const lineConfig = config.lines[lineKey.toLowerCase()];\n    if (!lineConfig) {\n      return res.status(404).json({\n        success: false,\n        errorCode: \'LINE_NOT_FOUND\',\n        message: `Line \'${lineKey}\' kh\303\264ng t\341\273\223n t\341\272\241i.`,\n      });\n    }\n\n    const stationConfig = lineConfig.stations[stationKey.toLowerCase()];\n    if (!stationConfig) {\n      return res.status(404).json({\n        success: false,\n        errorCode: \'STATION_NOT_FOUND\',\n        message: `Station \'${stationKey}\' kh\303\264ng thu\341\273\231c ${lineConfig.name}.`,\n      });\n    }\n\n    // Generate unique orderId strictly on backend\n    const orderId = stateManager.generateUniqueOrderId();\n\n    // Atomic try lock\n    const lockResult = stateManager.tryLockLine(lineKey.toLowerCase(), stationKey.toLowerCase(), orderId);\n    if (!lockResult.success) {\n      stateManager.addLog({\n        type: \'ORDER\',\n        line: lineKey,\n        station: stationKey,\n        success: false,\n        message: `B\341\273\213 t\341\273\253 ch\341\273\221i: ${lockResult.error}`,\n      });\n      return res.status(409).json({\n        success: false,\n        errorCode: \'LINE_LOCKED\',\n        message: lockResult.error,\n      });\n    }\n\n    // Build actual AMR payload\n    const orderPayload = {\n      modelProcessCode: config.orderCommon.modelProcessCode,\n      priority: config.orderCommon.priority,\n      fromSystem: config.orderCommon.fromSystem,\n      orderId: orderId,\n      taskOrderDetail: [\n        {\n          taskPath: lineConfig.taskPath,\n        },\n      ],\n    };\n\n    // Send HTTP POST to AMR System\n    const amrResult = await amrClient.sendOrder(orderPayload);\n\n    if (!amrResult.success) {\n      // Revert lock so line doesn\'t remain deadlocked on AMR network/rejection error\n      stateManager.resetLine(lineKey.toLowerCase());\n\n      stateManager.addLog({\n        type: \'ERROR\',\n        line: lineKey,\n        station: stationKey,\n        orderId: orderId,\n        payload: orderPayload,\n        response: amrResult.error,\n        success: false,\n        message: `G\341\273\255i L\341\273\207nh th\341\272\245t b\341\272\241i: ${amrResult.error}`,\n        durationMs: amrResult.durationMs,\n      });\n\n      return res.status(502).json({\n        success: false,\n        errorCode: \'AMR_FAILED\',\n        message: amrResult.error || \'AMR System kh\303\264ng ch\341\272\245p nh\341\272\255n y\303\252u c\341\272\247u.\',\n        orderId: orderId,\n        durationMs: amrResult.durationMs,\n      });\n    }\n\n    // Successful\n    stateManager.addLog({\n      type: \'ORDER\',\n      line: lineKey,\n      station: stationKey,\n      orderId: orderId,\n      payload: orderPayload,\n      response: amrResult.data,\n      success: true,\n      message: `T\341\272\241o ${lineConfig.orderLabel || lineConfig.name} th\303\240nh c\303\264ng (${orderId})`,\n      durationMs: amrResult.durationMs,\n    });\n\n    return res.json({\n      success: true,\n      orderId: orderId,\n      line: lineKey,\n      station: stationKey,\n      message: `\304\220\303\243 g\341\273\255i ${lineConfig.orderLabel || \'L\341\273\207nh\'} th\303\240nh c\303\264ng t\341\273\233i AMR System.`,\n      durationMs: amrResult.durationMs,\n      amrResponse: amrResult.data,\n    });\n  });\n\n  /**\n   * POST /api/trigger\n   * Body: { line: \"line-a\", station: \"pickup\" }\n   * Sends trigger with currentStation of the station\n   */\n  app.post(\'/api/trigger\', async (req, res) => {\n    const { line: lineKey, station: stationKey } = req.body || {};\n\n    if (!lineKey || !stationKey) {\n      return res.status(400).json({\n        success: false,\n        errorCode: \'INVALID_REQUEST\',\n        message: \'Y\303\252u c\341\272\247u thi\341\272\277u tham s\341\273\221 line ho\341\272\267c station.\',\n      });\n    }\n\n    const config = amrClient.getConfig();\n    const lineConfig = config.lines[lineKey.toLowerCase()];\n    if (!lineConfig) {\n      return res.status(404).json({\n        success: false,\n        errorCode: \'LINE_NOT_FOUND\',\n        message: `Line \'${lineKey}\' kh\303\264ng t\341\273\223n t\341\272\241i.`,\n      });\n    }\n\n    const stationConfig = lineConfig.stations[stationKey.toLowerCase()];\n    if (!stationConfig) {\n      return res.status(404).json({\n        success: false,\n        errorCode: \'STATION_NOT_FOUND\',\n        message: `Station \'${stationKey}\' kh\303\264ng t\341\273\223n t\341\272\241i.`,\n      });\n    }\n\n    const triggerPayload = {\n      currentStation: stationConfig.triggerStation,\n    };\n\n    const triggerResult = await amrClient.sendTrigger(triggerPayload);\n\n    if (!triggerResult.success) {\n      stateManager.addLog({\n        type: \'ERROR\',\n        line: lineKey,\n        station: stationKey,\n        payload: triggerPayload,\n        response: triggerResult.error,\n        success: false,\n        message: `Trigger \304\221i\341\273\203m ${stationConfig.triggerStation} th\341\272\245t b\341\272\241i: ${triggerResult.error}`,\n        durationMs: triggerResult.durationMs,\n      });\n\n      return res.status(502).json({\n        success: false,\n        errorCode: \'TRIGGER_FAILED\',\n        message: triggerResult.error || \'G\341\273\255i Trigger th\341\272\245t b\341\272\241i.\',\n        currentStation: stationConfig.triggerStation,\n        durationMs: triggerResult.durationMs,\n      });\n    }\n\n    stateManager.addLog({\n      type: \'TRIGGER\',\n      line: lineKey,\n      station: stationKey,\n      payload: triggerPayload,\n      response: triggerResult.data,\n      success: true,\n      message: `K\303\255ch ho\341\272\241t Trigger \304\221i\341\273\203m ${stationConfig.triggerStation} (${stationConfig.code}) th\303\240nh c\303\264ng`,\n      durationMs: triggerResult.durationMs,\n    });\n\n    return res.json({\n      success: true,\n      currentStation: stationConfig.triggerStation,\n      stationCode: stationConfig.code,\n      message: `Trigger \304\221i\341\273\203m ${stationConfig.triggerStation} th\303\240nh c\303\264ng.`,\n      durationMs: triggerResult.durationMs,\n      amrResponse: triggerResult.data,\n    });\n  });\n\n  /**\n   * POST /api/line/reset\n   * Body: { line: \"line-a\" }\n   * Manual reset to IDLE (Decision 1 Option A)\n   */\n  app.post(\'/api/line/reset\', (req, res) => {\n    const { line: lineKey } = req.body || {};\n    if (!lineKey) {\n      return res.status(400).json({\n        success: false,\n        errorCode: \'INVALID_REQUEST\',\n        message: \'Y\303\252u c\341\272\247u thi\341\272\277u tham s\341\273\221 line.\',\n      });\n    }\n\n    const result = stateManager.resetLine(lineKey.toLowerCase());\n    if (!result.success) {\n      return res.status(404).json({\n        success: false,\n        errorCode: \'LINE_NOT_FOUND\',\n        message: result.message,\n      });\n    }\n\n    return res.json({\n      success: true,\n      message: result.message,\n      line: lineKey,\n    });\n  });\n\n  /**\n   * GET /api/logs\n   * Returns recent events/communication logs\n   */\n  app.get(\'/api/logs\', (req, res) => {\n    res.json({\n      success: true,\n      data: stateManager.getLogs(),\n    });\n  });\n\n  /**\n   * POST /api/test/simulate\n   * Body: { mode: \"none\" | \"amr_down\" | \"amr_reject\" }\n   * Used for Phase 7 error testing\n   */\n  app.post(\'/api/test/simulate\', (req, res) => {\n    const { mode } = req.body || {};\n    if ([\'none\', \'amr_down\', \'amr_reject\'].includes(mode)) {\n      amrClient.setSimulateFailure(mode);\n      return res.json({\n        success: true,\n        mode: amrClient.getSimulateFailure(),\n        message: `\304\220\303\243 \304\221\341\273\225i ch\341\272\277 \304\221\341\273\231 m\303\264 ph\341\273\217ng sang: ${mode}`,\n      });\n    }\n    return res.status(400).json({\n      success: false,\n      message: \"Ch\341\272\277 \304\221\341\273\231 kh\303\264ng h\341\273\243p l\341\273\207. Ch\341\273\211 ch\341\272\245p nh\341\272\255n: \'none\', \'amr_down\', \'amr_reject\'\",\n    });\n  });\n\n  // --- VITE MIDDLEWARE SETUP ---\n  if (process.env.NODE_ENV !== \'production\') {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req, res) => {\n      res.sendFile(path.join(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`AMR Control Panel server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer().catch((err) => {\n  console.error(\'Failed to start server:\', err);\n});\n"
    }
