  file_change {
    absolute_path_uri: "file:///src/components/StationSelector.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { AllLinesConfig, LineState } from \'../types\';\nimport { api } from \'../services/api\';\nimport {\n  Layers,\n  ArrowRight,\n  MonitorSmartphone,\n  Smartphone,\n  CheckCircle2,\n  AlertCircle,\n  RefreshCw,\n  Terminal,\n} from \'lucide-react\';\n\ninterface StationSelectorProps {\n  onSelectStation: (lineKey: string, stationKey: string) => void;\n  onOpenLogs: () => void;\n}\n\nexport const StationSelector: React.FC<StationSelectorProps> = ({\n  onSelectStation,\n  onOpenLogs,\n}) => {\n  const [config, setConfig] = useState<AllLinesConfig | null>(null);\n  const [states, setStates] = useState<Record<string, LineState>>({});\n  const [loading, setLoading] = useState(true);\n\n  const loadData = async () => {\n    setLoading(true);\n    try {\n      const [cfgRes, stateRes] = await Promise.all([\n        api.getAllConfig(),\n        api.getAllStates(),\n      ]);\n      if (cfgRes.success && cfgRes.data) {\n        setConfig(cfgRes.data);\n      }\n      if (stateRes.success && stateRes.data) {\n        setStates(stateRes.data);\n      }\n    } catch (err) {\n      console.error(\'L\341\273\227i t\341\272\243i d\341\273\257 li\341\273\207u danh s\303\241ch station:\', err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    loadData();\n    const interval = setInterval(() => {\n      api.getAllStates().then((res) => {\n        if (res.success && res.data) {\n          setStates(res.data);\n        }\n      });\n    }, 2500);\n    return () => clearInterval(interval);\n  }, []);\n\n  return (\n    <div className=\"w-full max-w-md mx-auto space-y-5 pb-6\">\n      {/* Header */}\n      <div className=\"text-center space-y-1.5 pt-2\">\n        <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/30 text-sky-400 text-xs font-semibold\">\n          <MonitorSmartphone className=\"w-3.5 h-3.5\" />\n          <span>H\341\273\206 TH\341\273\220NG \304\220I\341\273\200U KHI\341\273\202N AMR</span>\n        </div>\n        <h1 className=\"text-2xl font-black text-white tracking-tight\">\n          Ch\341\273\215n Tr\341\272\241m V\341\272\255n H\303\240nh (Station)\n        </h1>\n        <p className=\"text-xs text-slate-400\">\n          M\341\273\227i PDA v\341\272\255t l\303\275 t\341\272\241i x\306\260\341\273\237ng \304\221\306\260\341\273\243c g\303\241n URL c\341\273\221 \304\221\341\273\213nh t\306\260\306\241ng \341\273\251ng theo t\341\273\253ng Station:\n        </p>\n      </div>\n\n      {/* Action Bar */}\n      <div className=\"flex items-center justify-between px-1\">\n        <button\n          id=\"refresh-selector-btn\"\n          onClick={loadData}\n          disabled={loading}\n          className=\"flex items-center gap-1.5 px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-medium\"\n        >\n          <RefreshCw className={`w-3.5 h-3.5 ${loading ? \'animate-spin\' : \'\'}`} />\n          <span>L\303\240m m\341\273\233i tr\341\272\241ng th\303\241i</span>\n        </button>\n\n        <button\n          id=\"selector-logs-btn\"\n          onClick={onOpenLogs}\n          className=\"flex items-center gap-1.5 px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-sky-400 rounded-lg text-xs font-medium\"\n        >\n          <Terminal className=\"w-3.5 h-3.5\" />\n          <span>Nh\341\272\255t k\303\275 giao ti\341\272\277p</span>\n        </button>\n      </div>\n\n      {/* Station List Cards */}\n      <div className=\"space-y-4\">\n        {config?.lines.map((line) => {\n          const lineStatus = states[line.key]?.status || \'idle\';\n          const isRunning = lineStatus === \'running\';\n\n          return (\n            <div\n              key={line.key}\n              className=\"bg-slate-900 border border-slate-700/80 rounded-2xl p-4 shadow-lg space-y-3\"\n            >\n              {/* Line Header */}\n              <div className=\"flex items-center justify-between border-b border-slate-800 pb-2.5\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-8 h-8 rounded-lg bg-sky-500/20 text-sky-400 flex items-center justify-center font-bold text-sm\">\n                    {line.name.replace(\'Line \', \'\')}\n                  </div>\n                  <div>\n                    <h2 className=\"font-bold text-white text-base leading-tight\">\n                      {line.name}\n                    </h2>\n                    <span className=\"text-[11px] text-slate-400\">\n                      L\341\273\207nh: {line.orderLabel}\n                    </span>\n                  </div>\n                </div>\n\n                <span\n                  className={`px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider ${\n                    isRunning\n                      ? \'bg-amber-500/20 text-amber-300 border border-amber-500/40 animate-pulse\'\n                      : \'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30\'\n                  }`}\n                >\n                  {isRunning ? \'\304\220ang ch\341\272\241y\' : \'S\341\272\265n s\303\240ng\'}\n                </span>\n              </div>\n\n              {/* Stations Grid */}\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                {line.stations.map((station) => (\n                  <button\n                    key={station.key}\n                    id={`select-station-${station.code.toLowerCase()}`}\n                    type=\"button\"\n                    onClick={() => onSelectStation(line.key, station.key)}\n                    className=\"p-3.5 rounded-xl bg-slate-800/80 hover:bg-slate-700/90 active:bg-slate-600/90 border border-slate-700 text-left transition-all duration-150 flex flex-col justify-between min-h-[92px] group shadow-sm\"\n                  >\n                    <div>\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"text-lg font-black text-white font-mono group-hover:text-sky-400 transition-colors\">\n                          {station.code}\n                        </span>\n                        <ArrowRight className=\"w-4 h-4 text-slate-500 group-hover:text-sky-400 group-hover:translate-x-0.5 transition-all\" />\n                      </div>\n                      <div className=\"text-xs font-semibold text-slate-200 mt-1\">\n                        {station.name}\n                      </div>\n                    </div>\n                    <div className=\"text-[10px] text-slate-400 font-mono mt-2 truncate\">\n                      URL: /control/{line.key}/{station.key}\n                    </div>\n                  </button>\n                ))}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Note for Operators */}\n      <div className=\"p-3.5 bg-slate-900/60 rounded-xl border border-slate-800/80 text-xs text-slate-400 leading-relaxed\">\n        <strong className=\"text-slate-200 block mb-0.5\">Ghi ch\303\272 v\341\272\255n h\303\240nh:</strong>\n        Khi m\341\273\237 tr\341\273\261c ti\341\272\277p \304\221\306\260\341\273\235ng d\341\272\253n c\341\273\221 \304\221\341\273\213nh c\341\273\247a Station (v\303\255 d\341\273\245{\' \'}\n        <code className=\"text-sky-300 font-mono\">/control/line-a/pickup</code>\n        ), giao di\341\273\207n s\341\272\275 m\341\273\237 th\341\272\263ng m\303\240n h\303\254nh \304\221i\341\273\201u khi\341\273\203n c\341\273\247a Station \304\221\303\263 m\303\240 kh\303\264ng c\341\272\247n qua trang ch\341\273\215n n\303\240y.\n      </div>\n    </div>\n  );\n};\n"
    }
